APP_NAME="Sistema Autónomo Comercial"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=America/Bogota
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=sac_db
DB_USERNAME=sac_user
DB_PASSWORD=secret

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
CACHE_STORE=redis

MAIL_MAILER=log

# Horizon
HORIZON_PREFIX=sac-horizon:

# n8n
N8N_BASE_URL=http://wfm.dosil.com.co/
N8N_API_KEY=

# WhatsMark
WHATSMARK_API_URL=https://chat.dosil.com.co/
WHATSMARK_DEFAULT_API_KEY=

# OpenRouter (default - tenants can override)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_DEFAULT_MODEL=google/gemini-2.0-flash

# App
APP_LOCALE=es
FILESYSTEM_DISK=public
